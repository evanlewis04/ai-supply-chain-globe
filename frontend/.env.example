# --- Local dev only (copy to frontend/.env.local, which is gitignored) ---
# The dev server passes this to Ask the Globe so you don't have to paste the
# key in the UI. Dev mode only — production builds never read it, and it is
# NOT the key the hosted demo uses.
VITE_ANTHROPIC_API_KEY=

# --- Hosted demo (set these in the Vercel dashboard, NOT here) ---
# The hosted build never ships an API key in the browser. Ask calls the
# /api/ask serverless proxy, which reads ANTHROPIC_API_KEY server-side. The
# whole site is gated by HTTP Basic Auth using BASIC_AUTH_USER / _PASSWORD.
# See README "Deploy" for the exact setup. Do not commit real values.
#   ANTHROPIC_API_KEY=      # server-side key for the Ask proxy
#   BASIC_AUTH_USER=        # demo login username
#   BASIC_AUTH_PASSWORD=    # demo login password
