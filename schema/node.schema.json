{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-supply-chain-globe/schema/node.schema.json",
  "title": "Node",
  "description": "A physical or logical entity in the AI supply chain, placed at a real geographic location. Every claim must be backed by at least one source.",
  "type": "object",
  "required": ["id", "name", "layer", "type", "location", "status", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case unique identifier, e.g. tsmc-fab-18"
    },
    "name": { "type": "string", "minLength": 1 },
    "layer": {
      "enum": ["energy", "chips", "infrastructure", "models", "applications"]
    },
    "type": {
      "enum": [
        "power_plant", "substation", "grid_region", "gas_pipeline", "water_supply",
        "fab", "packaging_facility", "memory_fab", "equipment_maker", "designer", "substrate_maker",
        "data_center", "ai_factory", "network_hub", "cooling_supplier", "server_assembly",
        "training_cluster", "model_artifact", "lab",
        "product", "deployment"
      ],
      "description": "Must belong to the node's layer; the layer/type pairing is cross-checked by build.py"
    },
    "operator": { "type": "string" },
    "ticker": {
      "type": "object",
      "required": ["symbol"],
      "additionalProperties": false,
      "description": "Public listing of the node's operator, if any. Drives the stock-performance overlay; price data itself is fetched mechanically (scripts/fetch_prices.py), never stored in the vault.",
      "properties": {
        "symbol": { "type": "string", "pattern": "^[A-Z0-9.\\-]{1,10}$" },
        "exchange": { "type": "string", "description": "e.g. NASDAQ, NYSE; note if the symbol is an ADR" }
      }
    },
    "location": {
      "type": "object",
      "required": ["lat", "lon", "country"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "country": { "type": "string", "minLength": 2, "maxLength": 2, "description": "ISO 3166-1 alpha-2" },
        "region": { "type": "string" },
        "precision": {
          "enum": ["site", "city", "region"],
          "description": "How precise the coordinates are. 'site' = exact facility, 'city' = city centroid, 'region' = regional centroid. Use the honest value."
        }
      }
    },
    "capacity": {
      "type": "object",
      "required": ["value", "unit", "as_of"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["number", "null"], "description": "null = publicly unknown; never invent a number" },
        "unit": { "type": ["string", "null"], "description": "e.g. wpm_12in, MW, wafers_per_year" },
        "as_of": { "$ref": "#/$defs/asOf" }
      }
    },
    "status": {
      "enum": ["planned", "construction", "operational", "ramping", "decommissioned"]
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "description": "IDs of constraint entities this node is gated by; cross-checked by build.py"
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}(-Q[1-4]|-\\d{2}(-\\d{2})?)?$",
      "description": "YYYY, YYYY-Qn, YYYY-MM, or YYYY-MM-DD"
    },
    "source": {
      "type": "object",
      "required": ["url", "date"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "title": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$", "description": "Publication date of the source" },
        "quote": { "type": "string", "description": "The specific sentence(s) supporting the claim" },
        "supports": { "type": "string", "description": "Which field(s)/claim(s) this source backs, e.g. 'capacity', 'location', 'status'" }
      }
    }
  }
}
