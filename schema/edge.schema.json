{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-supply-chain-globe/schema/edge.schema.json",
  "title": "Edge",
  "description": "A directed, typed flow between two nodes. The relationship itself is a claim and requires at least one source. Unknown volumes are null, never invented.",
  "type": "object",
  "required": ["id", "from", "to", "flow_type", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case unique identifier, e.g. tsmc18-to-tsmc-ap"
    },
    "from": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "to": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "flow_type": {
      "enum": [
        "wafers", "chips", "packaged_modules", "memory", "substrates", "equipment",
        "servers", "power", "water", "bandwidth", "compute", "tokens", "dollars", "model_weights"
      ]
    },
    "volume": {
      "type": "object",
      "required": ["value", "unit", "as_of"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["number", "null"], "description": "null = no defensible public number exists; explain in notes" },
        "unit": { "type": ["string", "null"] },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}(-Q[1-4]|-\\d{2}(-\\d{2})?)?$"
        }
      }
    },
    "lead_time_weeks": { "type": ["number", "null"], "minimum": 0 },
    "constraint_level": { "enum": ["low", "medium", "high"] },
    "substitutability": {
      "enum": ["low", "medium", "high"],
      "description": "How replaceable this link is. high constraint_level + low substitutability = red emphasis in the UI."
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "description": "IDs of constraint entities gating this flow; cross-checked by build.py"
    },
    "notes": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "node.schema.json#/$defs/source" }
    }
  }
}
